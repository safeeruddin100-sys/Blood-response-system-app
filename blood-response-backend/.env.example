# Database — SQLite for local dev, PostgreSQL for production
# Just change this connection string to switch databases (SQLAlchemy handles the rest)
DATABASE_URL=sqlite:///./blood_response.db

# MongoDB Configuration (actual database in use)
MONGO_URI=mongodb+srv://Cluster1:Haseeb@cluster1.sqjkasl.mongodb.net/?appName=Cluster1
DB_NAME=blood_response_db

# JWT Configuration
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-SECRET-IN-PRODUCTION
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Donor cooldown (days after donation before they're available again)
COOLDOWN_DAYS=90

# Default search radius for nearby donors (km)
DEFAULT_SEARCH_RADIUS_KM=25

# OTP settings
OTP_LENGTH=6
# Provider: "console" for dev stub, "email" for Gmail SMTP, "twilio" for SMS
SMS_PROVIDER=email

# Gmail SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
OTP_EMAIL_FROM=your_email@gmail.com

# App settings
APP_NAME=Blood Response System
DEBUG=true